# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public (they end up in the browser bundle); row level security
# in supabase/migrations/0001_init.sql is what keeps the circle closed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
